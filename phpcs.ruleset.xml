<?xml version="1.0"?>
<ruleset name="WPMUDEV Plugin Test WPCS">
  <description>WPCS rules for this plugin</description>

  <!-- Scan these paths -->
  <file>app</file>
  <file>wpmudev-plugin-test.php</file>

  <!-- Ignore build/vendor assets -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/assets/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>

  <!-- Base standard -->
  <rule ref="WordPress" />
  <rule ref="WordPress-Core" />
  <rule ref="WordPress-Docs" />
  <rule ref="WordPress-Extra" />

  <!-- Strengthen security checks -->
  <rule ref="WordPress.Security.EscapeOutput" />
  <rule ref="WordPress.Security.NonceVerification" />
  <rule ref="WordPress.Security.ValidatedSanitizedInput" />

  <!-- Reasonable tweaks -->
  <config name="testVersion" value="8.0-"/> <!-- PHP 8+ -->
  <arg value="sp"/> <!-- show sniff codes -->
  <arg name="extensions" value="php"/>

  <!-- Example: allow long lines (optional) -->
  <!-- <rule ref="Generic.Files.LineLength">
    <properties><property name="lineLimit" value="140"/></properties>
  </rule> -->

  <!-- Exclude file naming warnings for main plugin file -->
  <rule ref="WordPress.Files.FileName.InvalidClassFileName">
    <exclude-pattern>wpmudev-plugin-test\.php</exclude-pattern>
    <exclude-pattern>class-posts-maintenance\.php</exclude-pattern>
    <exclude-pattern>class-posts-maintenance-cli\.php</exclude-pattern>
    <exclude-pattern>class-posts-maintenance-cron\.php</exclude-pattern>
    <exclude-pattern>class-googledrive-settings\.php</exclude-pattern>
    <exclude-pattern>class-googledrive-rest\.php</exclude-pattern>
  </rule>
</ruleset>
